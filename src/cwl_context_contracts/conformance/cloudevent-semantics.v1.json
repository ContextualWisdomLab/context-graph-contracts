{
  "profile_id": "urn:cwl:conformance:cloudevent-semantics:v1",
  "title": "CWL CloudEvent Semantic Profile v1",
  "normative_requirements": [
    "Consumers MUST apply these semantic vectors in addition to Draft 2020-12 structural validation because the default format vocabulary is annotation-only and cross-field tenant invariants are not expressed by the structural schema.",
    "When present, dataschema MUST be a non-empty RFC 3986 URI with a scheme; raw non-ASCII characters, malformed percent-encoding, malformed generic delimiters, and malformed authority syntax are invalid URI syntax.",
    "source and subject MUST identify the same tenant.",
    "When present, the tenantid extension MUST equal the source tenant identifier."
  ],
