{
  "asyncapi": "3.1.0",
  "id": "urn:cwl:shared:context_graph_contracts",
  "info": {
    "title": "CWL Context Graph Contract Components",
    "version": "0.1.0",
    "description": "Provider-neutral reusable event components. This contract deliberately defines no servers, channels, operations, broker addresses, or runtime topology."
  },
  "defaultContentType": "application/cloudevents+json",
  "components": {
    "messages": {
      "ContextGraphCloudEvent": {
        "name": "ContextGraphCloudEvent",
        "title": "Context Graph CloudEvent",
        "summary": "Reusable structured CloudEvents envelope for Context Fabric interoperability.",
        "contentType": "application/cloudevents+json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-2020-12",
          "schema": {
            "$ref": "https://schemas.contextualwisdomlab.org/context/cloudevent-envelope.v1.schema.json"
          }
        }
      },
      "ContextAssertionEvent": {
        "name": "ContextAssertionEvent",
        "title": "Context Assertion Event",
        "summary": "Reusable structured CloudEvent whose data is a typed, multi-affiliated context assertion.",
        "contentType": "application/cloudevents+json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-2020-12",
          "schema": {
            "allOf": [
              {
                "$ref": "https://schemas.contextualwisdomlab.org/context/cloudevent-envelope.v1.schema.json"
              },
              {
                "type": "object",
                "required": ["type", "dataschema", "data"],
                "properties": {
                  "type": {
                    "const": "org.contextualwisdomlab.context_graph.assertion.v1"
                  },
                  "dataschema": {
                    "const": "https://schemas.contextualwisdomlab.org/context/context-assertion.v1.schema.json"
                  },
                  "data": {
                    "$ref": "https://schemas.contextualwisdomlab.org/context/context-assertion.v1.schema.json"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
