{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/context/cloudevent-envelope.v1.schema.json",
  "title": "CWL CloudEvent Envelope",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source": {"$ref": "https://schemas.contextualwisdomlab.org/context/canonical-authority-uri.v1.schema.json"},
    "type": {"type": "string", "pattern": "^org\\.contextualwisdomlab\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[1-9][0-9]*$"},
    "subject": {"$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"},
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"type": "string", "format": "uri"},
    "data": {"type": "object"}
  },
  "propertyNames": {"pattern": "^[a-z][a-z0-9]{0,19}$"},
  "additionalProperties": {"type": "string", "minLength": 1}
}
