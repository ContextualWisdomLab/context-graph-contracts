{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/context/data-management-framework.v1.schema.json",
  "title": "CWL Data Management Framework Contract",
  "description": "Framework-neutral contract for CWL-authored capability, evidence, and assessment mappings to externally governed data-management frameworks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "framework_reference",
    "capability_definition",
    "assessment_profile"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "framework_reference": {
      "$ref": "#/$defs/framework_reference"
    },
    "capability_definition": {
      "$ref": "#/$defs/capability_definition"
    },
    "assessment_profile": {
      "$ref": "#/$defs/assessment_profile"
    }
  },
  "$defs": {
    "code_string": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 128
    },
    "framework_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_code",
        "framework_version",
        "publisher_name",
        "official_reference_uri",
        "license_classification"
      ],
      "properties": {
        "framework_code": {
          "$ref": "#/$defs/code_string"
        },
        "framework_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "publisher_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        "official_reference_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "license_classification": {
          "type": "string",
          "enum": [
            "public_reference",
            "licensed_internal",
            "restricted_profile"
          ]
        }
      }
    },
    "capability_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_code",
        "capability_name",
        "definition_text",
        "source_authority_uri",
        "truth_status",
        "provenance"
      ],
      "properties": {
        "capability_code": {
          "$ref": "#/$defs/code_string"
        },
        "capability_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        "definition_text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4096
        },
        "source_authority_uri": {
          "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-authority-uri.v1.schema.json"
        },
        "truth_status": {
          "$ref": "https://schemas.contextualwisdomlab.org/context/truth-status.v1.schema.json"
        },
        "provenance": {
          "$ref": "https://schemas.contextualwisdomlab.org/context/provenance-reference.v1.schema.json"
        },
        "external_framework_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$",
          "description": "Opaque external identifier only; do not copy publisher-owned framework prose into this field."
        }
      }
    },
    "assessment_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_code",
        "evidence_requirements",
        "scoring_dimension_codes"
      ],
      "properties": {
        "profile_code": {
          "$ref": "#/$defs/code_string"
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_requirement"
          }
        },
        "scoring_dimension_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code_string"
          },
          "description": "CWL-authored provider-neutral scoring dimension identifiers, not copied publisher scoring criteria."
        }
      }
    },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_code",
        "evidence_type",
        "authority_uri",
        "truth_status",
        "provenance"
      ],
      "properties": {
        "evidence_code": {
          "$ref": "#/$defs/code_string"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "policy",
            "process",
            "record",
            "measurement",
            "control",
            "decision",
            "artifact"
          ]
        },
        "authority_uri": {
          "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-authority-uri.v1.schema.json"
        },
        "truth_status": {
          "$ref": "https://schemas.contextualwisdomlab.org/context/truth-status.v1.schema.json"
        },
        "provenance": {
          "$ref": "https://schemas.contextualwisdomlab.org/context/provenance-reference.v1.schema.json"
        }
      }
    }
  }
}
