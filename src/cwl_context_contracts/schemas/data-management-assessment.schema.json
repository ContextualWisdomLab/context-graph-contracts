{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/context/data-management-assessment.v1.schema.json",
  "$comment": "Assessment-result evidence is append-only at the owning product boundary. Timestamp validation reuses the CWL bitemporal lexical grammar and consumers MUST also satisfy the packaged CWL Timestamp Profile semantic vectors.",
  "title": "CWL Data Management Assessment Result",
  "description": "Framework-neutral immutable-result evidence for a CWL-authored data-management assessment without embedding publisher-owned scoring criteria or framework prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "assessment_result_id",
    "framework_code",
    "framework_version",
    "profile_code",
    "profile_version",
    "tenant_authority_uri",
    "subject_ref",
    "knowledge_cutoff_at",
    "recorded_at",
    "overall_score_basis_points",
    "dimension_scores",
    "readiness",
    "missing_evidence_codes",
    "truth_status",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "assessment_result_id": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"
    },
    "framework_code": {
      "$ref": "#/$defs/code_string"
    },
    "framework_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profile_code": {
      "$ref": "#/$defs/code_string"
    },
    "profile_version": {
      "$ref": "#/$defs/semantic_version"
    },
    "tenant_authority_uri": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-authority-uri.v1.schema.json"
    },
    "subject_ref": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"
    },
    "knowledge_cutoff_at": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/bitemporal-interval.v1.schema.json#/properties/recorded_at"
    },
    "recorded_at": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/bitemporal-interval.v1.schema.json#/properties/recorded_at"
    },
    "overall_score_basis_points": {
      "$ref": "#/$defs/score_basis_points"
    },
    "dimension_scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimension_score"
      }
    },
    "readiness": {
      "type": "string",
      "enum": ["evidence_complete", "evidence_gap"]
    },
    "missing_evidence_codes": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code_string"
      }
    },
    "truth_status": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/truth-status.v1.schema.json"
    },
    "provenance": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/provenance-reference.v1.schema.json"
    },
    "supersedes_result_ref": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness": {"const": "evidence_complete"}
        },
        "required": ["readiness"]
      },
      "then": {
        "properties": {
          "missing_evidence_codes": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {"const": "evidence_gap"}
        },
        "required": ["readiness"]
      },
      "then": {
        "properties": {
          "missing_evidence_codes": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "code_string": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 128
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 64
    },
    "score_basis_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Exact provider-neutral score on an integer 0..10000 basis-point scale. Interpretation belongs to the exact referenced CWL assessment profile code and version, not this interoperability schema."
    },
    "dimension_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_code", "score_basis_points"],
      "properties": {
        "dimension_code": {
          "$ref": "#/$defs/code_string"
        },
        "score_basis_points": {
          "$ref": "#/$defs/score_basis_points"
        }
      }
    }
  }
}
