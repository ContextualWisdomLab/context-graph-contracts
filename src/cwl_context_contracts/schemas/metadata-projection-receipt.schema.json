{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/context/metadata-projection-receipt.v1.schema.json",
  "$comment": "Receipts are minted only by the reference admission function. Schema validation proves shape, not that a receipt was issued by admission.",
  "title": "CWL Metadata Projection Receipt",
  "description": "Attestation of one admission decision over one external metadata observation, with a bounded reason code and contract, profile, and admission versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "reason_code",
    "observation_id",
    "event_id",
    "subject_ref",
    "truth_status",
    "source_authority",
    "provider_code",
    "source_release",
    "external_entity_type",
    "external_id",
    "replay_id",
    "payload_sha256",
    "normalized_sha256",
    "provenance",
    "contract_version",
    "schema_id",
    "profile_id",
    "profile_version",
    "admission_version"
  ],
  "properties": {
    "result": {
      "type": "string",
      "enum": [
        "admitted",
        "rejected"
      ]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "admitted_evidence",
        "admitted_owner_disposition",
        "owner_disposition_forbidden",
        "tenant_scope_mismatch",
        "source_authority_mismatch",
        "replay_identity_mismatch",
        "supersession_authority_mismatch",
        "supersession_self_reference",
        "provenance_scope_mismatch"
      ]
    },
    "observation_id": {
      "type": "string",
      "allOf": [
        {
          "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"
        },
        {
          "pattern": "^urn:cwl:[^:]+:[^:]+:metadata_observation:"
        }
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subject_ref": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"
    },
    "truth_status": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/truth-status.v1.schema.json"
    },
    "source_authority": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/canonical-authority-uri.v1.schema.json"
    },
    "provider_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "source_release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "external_entity_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "replay_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "$ref": "https://schemas.contextualwisdomlab.org/context/provenance-reference.v1.schema.json"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_id": {
      "const": "https://schemas.contextualwisdomlab.org/context/metadata-observation-envelope.v1.schema.json"
    },
    "profile_id": {
      "const": "urn:cwl:context-contracts:external-metadata-observation-semantics:v1"
    },
    "profile_version": {
      "type": "integer",
      "const": 1
    },
    "admission_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "admitted_evidence",
              "admitted_owner_disposition"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "reason_code": {
            "enum": [
              "owner_disposition_forbidden",
              "tenant_scope_mismatch",
              "source_authority_mismatch",
              "replay_identity_mismatch",
              "supersession_authority_mismatch",
              "supersession_self_reference",
              "provenance_scope_mismatch"
            ]
          }
        }
      }
    }
  ]
}
