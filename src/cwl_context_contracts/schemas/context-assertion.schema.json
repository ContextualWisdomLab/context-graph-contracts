{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/context/context-assertion.v1.schema.json",
  "title": "CWL Context Assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_id", "subject", "predicate", "object", "truth_status", "interval", "memberships"],
  "properties": {
    "assertion_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subject": {"$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"},
    "predicate": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "object": {"$ref": "https://schemas.contextualwisdomlab.org/context/canonical-asset-uri.v1.schema.json"},
    "truth_status": {"$ref": "https://schemas.contextualwisdomlab.org/context/truth-status.v1.schema.json"},
    "interval": {"$ref": "https://schemas.contextualwisdomlab.org/context/bitemporal-interval.v1.schema.json"},
    "provenance": {
      "oneOf": [
        {"$ref": "https://schemas.contextualwisdomlab.org/context/provenance-reference.v1.schema.json"},
        {"type": "null"}
      ]
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "https://schemas.contextualwisdomlab.org/context/context-membership.v1.schema.json"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "truth_status": {"enum": ["authoritative", "observed"]}
        },
        "required": ["truth_status"]
      },
      "then": {
        "required": ["provenance"],
        "properties": {
          "provenance": {"$ref": "https://schemas.contextualwisdomlab.org/context/provenance-reference.v1.schema.json"}
        }
      }
    }
  ]
}
